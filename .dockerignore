# Build context exclusions for the FastAPI server image.
#
# Keep this narrow: it must exclude everything below without ever matching
# pyproject.toml, uv.lock, or src/ — those are the only inputs the
# Dockerfile actually needs (see Dockerfile).

# VCS
.git
.github

# Python virtualenvs / caches — rebuilt inside the image by `uv sync`
.venv
.venv-win
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info

# Secrets — injected at runtime via env/--env-file, never baked into the image
.env
.env.*
!.env.example

# Local corpus/data — mounted as a runtime volume, never copied into the image
data/

# Evaluation results — local run artifacts, not build input
evaluation/results/

# Logs
*.log
logs/

# IDE metadata
.vscode
.idea
*.swp

# OS junk
.DS_Store
Thumbs.db
