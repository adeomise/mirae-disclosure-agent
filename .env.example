APP_ENV=local
LOG_LEVEL=INFO
DATA_ROOT=./data

# HyperCLOVA X. 셋이 모두 채워졌을 때만 연동이 켜진다. 하나라도 비면 결정론 문장을 그대로
# 쓴다(오류가 아니다).
HYPERCLOVA_API_KEY=
# v3 chat-completions 경로. 모델까지 포함한 완전한 경로여도 되고, 여기까지만 줘도 된다.
# 뒤쪽이면 HYPERCLOVA_MODEL이 {modelName} 자리에 붙는다.
#   https://clovastudio.stream.ntruss.com/v3/chat-completions
#   https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-007
HYPERCLOVA_API_URL=
# 권장값은 HCX-007이다.
#
# 표현 단계는 문장 하나가 아니라 검증 가능한 JSON 봉투를 요구하는데(verbalizer.SYSTEM_PROMPT),
# 그 봉투를 서버가 강제해 주는 모델이 HCX-007뿐이다. HCX-005는 같은 지시문에 대해 내용은 맞고
# 형식은 평문인 답을 돌려주며, 그 답은 not_json으로 버려진다. 연동이 정상인데도 결정론 문장만
# 나가는 상태가 그렇게 만들어진다.
#
# HCX-005/HCX-DASH-002도 그대로 동작한다. 요청 본문은 모델에 맞춰 자동으로 갈린다
# (agent.hyperclova.MODEL_CAPABILITIES).
HYPERCLOVA_MODEL=HCX-007

# 아래는 모두 선택이다. 값은 기본값이다.
# 자격 증명이 갖춰진 환경에서 결정론 경로만 쓰고 싶을 때 끈다.
#HYPERCLOVA_ENABLED=true
#HYPERCLOVA_TIMEOUT_SECONDS=10.0
# 재시도 '추가' 횟수(0-3). 0이면 한 번만 호출한다.
#HYPERCLOVA_MAX_RETRIES=1
# 출력 토큰 상한(1-4096). 작으면 응답이 JSON을 닫지 못한 채 잘리고 표현 단계가 거절된다.
#HYPERCLOVA_MAX_TOKENS=512

VECTOR_SEARCH_ENABLED=false
